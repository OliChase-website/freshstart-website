---
import '../styles/global.css';
import biz from '../data/business.json';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: biz.name,
  url: new URL('/', Astro.site).href,
  telephone: biz.phone,
  email: biz.email,
  priceRange: '₱690–₱69,990',
  openingHours: biz.openingHours,
  areaServed: biz.areas.map((a) => ({ '@type': 'Place', name: `${a}, ${biz.city}` })),
  sameAs: [biz.facebook, biz.instagram, biz.tiktok].filter((u) => !u.includes('[')),
};
const schemas = [localBusiness, ...jsonLd];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={biz.name} />
  <meta name="theme-color" content="#0E4F4A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Figtree:wght@400;600;700&display=swap" />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/">FreshStart<small>Cleaning Co.</small></a>
      <nav class="nav" aria-label="Main">
        <a href="/house-cleaning/">House cleaning</a>
        <a href="/commercial-cleaning/">Business cleaning</a>
        <a href="/property-management/landlord-turnover-cleaning/">Landlords</a>
        <a href="/prices/">Prices</a>
        <a href="/book/">Book</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p><strong>{biz.name}</strong> · {biz.tagline}</p>
      <p>Serving {biz.areas.join(', ')}, {biz.city}. {biz.hours}.</p>
      <p>Call or Viber {biz.phoneDisplay} · <a href={biz.messengerUrl}>Messenger</a> · <a href={`mailto:${biz.email}`}>{biz.email}</a></p>
      <p><a href="/prices/">Prices</a> · <a href="/about/">About and trust</a> · <a href="/blog/">Guides</a> · <a href="/book/">Book a clean</a></p>
    </div>
  </footer>
  <div class="sticky-cta">
    <a class="btn btn-primary" href={biz.messengerUrl}>Book on Messenger</a>
    <a class="btn btn-secondary" href={`tel:${biz.phone}`}>Call</a>
  </div>
</body>
</html>
