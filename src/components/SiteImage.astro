---
// Renders the image for one slot in src/data/images.json, as responsive AVIF/WebP with a JPEG
// fallback. Renders nothing at all until the slot's file exists in src/assets/images/.
// With `fallback`, a sub-service without its own photo borrows its parent service's photo.
import { Picture } from 'astro:assets';
import { findImage, findImageOrParent } from '../lib/images';

interface Props {
  slot: string;
  priority?: boolean;   // true for the hero: loads immediately instead of lazily
  fallback?: boolean;   // use the parent service's image when this slot has none
  sizes?: string;
  class?: string;
}
const { slot, priority = false, fallback = false, sizes = '(min-width: 900px) 520px, 100vw', class: className } = Astro.props;
const img = fallback ? findImageOrParent(slot) : findImage(slot);
const widths = img ? [400, 640, 960, 1280].filter((w) => w < img.src.width) : [];
if (img) widths.push(img.src.width);
---
{img && (
  <Picture
    src={img.src}
    alt={img.alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class={className}
  />
)}
