---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import SiteImage from '../components/SiteImage.astro';
import AreasServed from '../components/AreasServed.astro';
import biz from '../data/business.json';
import { findImage } from '../lib/images';
const primaries = (await getCollection('services', ({ data }) => !data.draft && data.level === 'primary')).sort((a, b) => a.data.order - b.data.order);
const landlords = (await getCollection('services', ({ data }) => !data.draft && data.parent === 'property-management')).sort((a, b) => a.data.order - b.data.order);
const hasHero = findImage('home-hero') !== null;
const hasBooking = findImage('home-booking') !== null;
---
<Base title="Cleaning Services in Fairview & Novaliches, QC | FreshStart" description="House, condo, rental and small business cleaning in Fairview, Lagro and Novaliches, Quezon City. Fixed prices with transport and photo reports. From ₱999." ogSlot="home-hero">
  <section class="hero">
    <div class={`wrap${hasHero ? ' hero-grid' : ''}`}>
      <div>
        <h1>Cleaning services in Fairview, Lagro and Novaliches</h1>
        <p>Trained, NBI-cleared cleaners for houses, condos, rentals and small businesses in northern Quezon City. Fixed prices with transport included, a before-and-after photo report on every job, and a free re-clean within 48 hours.</p>
        <p class="area-line">Serving {biz.areas.join(', ')}, {biz.city}</p>
        <p class="price" style="font-size:1.4rem;color:#FF9A5C">Starter Clean ₱999 · deep cleans from ₱2,890</p>
        <p class="cta-row"><CtaButtons dark /><a class="btn btn-secondary" href="/prices/" style="background:#0A3834">See all prices</a></p>
      </div>
      {hasHero && <SiteImage slot="home-hero" priority class="hero-img" />}
    </div>
  </section>
  <div class="wrap">
    <h2>What we do</h2>
    <div class="cards">
      {primaries.map((p) => (
        <a class="card" href={`/${p.data.url}/`}><h3>{p.data.menuLabel ?? p.data.h1}</h3><p style="margin:0 0 6px">{p.data.hero}</p><span class="price">{p.data.priceFrom}</span></a>
      ))}
      {landlords.map((p) => (
        <a class="card" href={`/${p.data.url}/`}><h3>{p.data.menuLabel ?? p.data.h1}</h3><p style="margin:0 0 6px">{p.data.hero}</p><span class="price">{p.data.priceFrom}</span></a>
      ))}
    </div>
    <h2>Why households and businesses choose FreshStart</h2>
    <ul>
      <li><strong>Fixed prices, transport included</strong> in {biz.areas.join(', ')}. No "message us for rates".</li>
      <li><strong>The same trained team</strong> every visit, paid above minimum wage with full benefits.</li>
      <li><strong>Proof on every job:</strong> before-and-after photos sent to you on Messenger or Viber.</li>
      <li><strong>48-hour re-clean guarantee</strong> if anything on the checklist was missed.</li>
      <li><strong>Local crews</strong> who live in northern Quezon City, so we arrive on time.</li>
    </ul>
    <div class={hasBooking ? 'split' : ''}>
      <div>
        <h2>How booking works</h2>
        <ol>
          <li>Message us your home size or business, the service and your preferred date.</li>
          <li>Get a fixed quote, usually within the hour.</li>
          <li>Confirm with a 50% deposit for jobs over ₱3,000 (GCash, Maya or bank transfer).</li>
          <li>We clean, walk through it with you and send the photo report. Then you pay the balance.</li>
        </ol>
      </div>
      {hasBooking && <SiteImage slot="home-booking" class="section-img" />}
    </div>
    <AreasServed />
    <p>See every service and rate on our <a href="/prices/">cleaning prices page</a>, updated {biz.pricesUpdated}.</p>
  </div>
</Base>
