---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import SiteImage from '../components/SiteImage.astro';
import AreasServed from '../components/AreasServed.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Faqs from '../components/Faqs.astro';
import biz from '../data/business.json';
import { contact } from '../lib/contact';
import { findImage, findImageOrParent, shareImage } from '../lib/images';

export async function getStaticPaths() {
  const all = await getCollection('services', ({ data }) => !data.draft);
  return all.map((entry) => ({ params: { slug: entry.data.url }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const site = Astro.site!;
// Breadcrumb parent: the real primary page when it is live, else the interim parent (e.g. the
// property pages sit under House cleaning until the Property management page goes live).
const parent =
  (d.parent ? all.find((s) => s.data.url === d.parent) : undefined) ??
  (d.breadcrumbParent ? all.find((s) => s.data.url === d.breadcrumbParent) : undefined);
const children = all
  .filter((s) => s.data.parent === d.url)
  .sort((a, b) => a.data.order - b.data.order);
const related = d.related
  .map((u) => all.find((s) => s.data.url === u))
  .filter((s) => s !== undefined);
const pageUrl = new URL(`/${d.url}/`, site).href;
const hasHero = findImage(d.url) !== null;
const share = await shareImage(site, d.url);
const showPhoto = findImageOrParent(d.url) !== null;

const crumbs = [{ name: 'Home', url: '/' }];
if (parent) crumbs.push({ name: parent.data.menuLabel ?? parent.data.h1, url: `/${parent.data.url}/` });
crumbs.push({ name: d.menuLabel ?? d.h1, url: `/${d.url}/` });

const areaServed = biz.areas.map((a) => ({ '@type': 'Place', name: `${a}, ${biz.city}` }));
const provider = {
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', site).href,
  name: biz.name,
  url: new URL('/', site).href,
  ...(contact.phone ? { telephone: contact.phone } : {}),
};
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: d.serviceType,
    name: d.h1,
    description: d.description,
    url: pageUrl,
    ...(hasHero ? { image: share.url } : {}),
    provider,
    areaServed,
    ...(d.offerPrice ? { offers: { '@type': 'Offer', price: String(d.offerPrice), priceCurrency: 'PHP', url: pageUrl } } : {}),
    ...(children.length
      ? {
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: d.menuLabel ?? d.h1,
            itemListElement: children.map((c) => ({
              '@type': 'Offer',
              url: new URL(`/${c.data.url}/`, site).href,
              ...(c.data.offerPrice ? { price: String(c.data.offerPrice), priceCurrency: 'PHP' } : {}),
              itemOffered: { '@type': 'Service', name: c.data.menuLabel ?? c.data.h1, serviceType: c.data.serviceType },
            })),
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, site).href })),
  },
];
if (d.faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const msg = `Hi FreshStart! I'd like a quote for ${(d.menuLabel ?? d.h1).toLowerCase()}.`;
---
<Base title={d.title} description={d.description} jsonLd={jsonLd} ogSlot={d.url} ctaMessage={msg}>
  <section class={showPhoto ? 'phero' : 'hero'}>
    {showPhoto && <div class="phero-media"><SiteImage slot={d.url} fallback priority sizes="(min-width: 900px) 50vw, 100vw" /></div>}
    <div class={showPhoto ? 'wrap phero-body' : 'wrap'}>
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (i < crumbs.length - 1 ? <><a href={c.url}>{c.name}</a> › </> : <span>{c.name}</span>))}
      </nav>
      <h1>{d.h1}</h1>
      <p class="phero-lede">{d.hero}</p>
      <p class="area-line">Serving {biz.areas.join(', ')}, {biz.city}</p>
      <p class="pricetag">{d.priceFrom}</p>
      <p class="cta-row"><CtaButtons message={msg} quote dark /></p>
      <div class="trust"><span>Transport included</span><span>Trained, NBI-cleared crew</span><span>Photo report</span><span>48-hour re-clean</span></div>
    </div>
  </section>

  <div class="wrap">
    {children.length > 0 && (
      <section class="section">
        <h2>Our {(d.menuLabel ?? d.h1).toLowerCase()} services</h2>
        <div class="tiles">
          {children.map((c) => (
            <ServiceCard url={c.data.url} label={c.data.menuLabel ?? c.data.h1} blurb={c.data.hero} price={c.data.priceFrom} />
          ))}
        </div>
      </section>
    )}

    <article class="content">
      <Content />
    </article>

    <p class="muted">{biz.transportNote} Prices updated {biz.pricesUpdated}. <a href="/prices/">See all our prices</a>.</p>

    <AreasServed />

    {d.faqs.length > 0 && <Faqs faqs={d.faqs} />}

    {(related.length > 0 || (parent && d.level === 'secondary')) && (
      <section class="section">
        <h2>Related services</h2>
        <div class="tiles">
          {parent && d.level === 'secondary' && !related.some((r) => r!.data.url === parent.data.url) && (
            <ServiceCard url={parent.data.url} label={`All ${(parent.data.menuLabel ?? parent.data.h1).toLowerCase()} services`} price={parent.data.priceFrom} />
          )}
          {related.map((r) => (
            <ServiceCard url={r!.data.url} label={r!.data.menuLabel ?? r!.data.h1} price={r!.data.priceFrom} />
          ))}
        </div>
      </section>
    )}
  </div>

  <section class="band">
    <div class="wrap">
      <h2>Ready for a fresh start?</h2>
      <p>Send us your home size, the service and your preferred date. We reply with a fixed price, usually within the hour.</p>
      <p class="cta-row"><CtaButtons message={msg} callLabel /></p>
    </div>
  </section>
</Base>
