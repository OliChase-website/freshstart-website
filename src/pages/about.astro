---
import Base from '../layouts/Base.astro';
import SiteImage from '../components/SiteImage.astro';
import AreasServed from '../components/AreasServed.astro';
import biz from '../data/business.json';
import { findImage } from '../lib/images';
const hasTeam = findImage('about-team') !== null;
const hasTraining = findImage('about-training') !== null;
---
<Base title="About FreshStart Cleaning Co. | Trained, Local Crews in QC" description="How FreshStart hires, trains and pays its cleaners, and the promises behind every job: fixed prices, photo reports, a damage guarantee, a 48-hour re-clean." ogSlot="about-team">
  <section class="hero"><div class="wrap"><h1>About FreshStart Cleaning Co.</h1><p>{biz.tagline} We are a northern Quezon City team cleaning homes, rentals and small businesses in {biz.areas.join(', ')}.</p></div></section>
  <div class="wrap">
    {hasTeam && <SiteImage slot="about-team" class="section-img" sizes="(min-width: 1080px) 1040px, 100vw" />}
    <section class={`section${hasTraining ? ' split' : ''}`}>
      <div>
        <h2>How we hire and train</h2>
        <p>Every cleaner passes an interview, a paid practical test, NBI and barangay clearance and a medical check, then three days of paid training on our checklists, chemical safety and client privacy.</p>
      </div>
      {hasTraining && <SiteImage slot="about-training" class="section-img" sizes="(min-width: 900px) 540px, 100vw" />}
    </section>
    <div class="content">
    <h2>How we treat our team</h2>
    <p>Our cleaners are employees, paid above the NCR minimum wage with SSS, PhilHealth, Pag-IBIG and 13th month pay. Stable, fairly paid crews do better work, and you get the same faces every visit.</p>
    <h2>Our promises</h2>
    <ul class="checks">
      <li>Fixed prices with transport included in our service areas.</li>
      <li>A before-and-after photo report after every job.</li>
      <li>A free re-clean within 48 hours if anything on the checklist was missed.</li>
      <li>Damage reported immediately with photos, and repaired or reimbursed.</li>
      <li>No photos of your family, documents or personal items, ever.</li>
    </ul>
    </div>
    <AreasServed />
    <p>Ready to book? See our <a href="/prices/">prices</a>, our <a href="/house-cleaning/">house cleaning</a> and <a href="/commercial-cleaning/">business cleaning</a> services, or <a href="/book/">book a clean</a>.</p>
  </div>
</Base>
