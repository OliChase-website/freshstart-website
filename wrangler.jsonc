// Cloudflare Workers static-assets config. Cloudflare builds the site with
// `npm run build`, then `npx wrangler deploy` publishes the dist/ folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freshstart-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Branch builds (pull requests) run `npx wrangler preview`, which needs this block (it can be empty)
  // and gives each branch its own preview URL. Production still deploys with `npx wrangler deploy`.
  "previews": {}
}
